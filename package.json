{
  "name": "electric-wealth-web",
  "version": "0.1.0",
  "private": true,
  "description": "Electric Wealth web app (React + Vite). API types are generated from electric-wealth-api-spring's openapi.json.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "gen:api": "openapi-typescript ../electric-wealth-api-spring/openapi.json -o src/api/schema.d.ts",
    "check:api": "openapi-typescript ../electric-wealth-api-spring/openapi.json -o src/api/schema.d.ts --check",
    "verify": "npm run check:api && npm run typecheck"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "i18next": "^26.4.2",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.3"
  },
  "allowScripts": {
    "fsevents": false
  }
}
